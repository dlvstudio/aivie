ĐÁP: ```python
import re

def check_str(s):
    # Check if string is a bigger string
    if len(s) > 1:
        return False
    # Check if string has only one character
    if s[0] != 'a':
        return False
    # Check if string has only one character
    if s[0] == 's':
        return False
    # Check if string is a bigger string
    if len(s) > 1:
        return True

# Test the function
print(check_str("AB"))
```

